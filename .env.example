# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these under Vercel → Project → Settings → Environment Variables.
# Never commit real keys — .env* is already in .gitignore.

# Serper.dev — web + news search. Free trial credits, no card required to start.
# Get a key: https://serper.dev
SERPER_API_KEY=

# Anthropic API — entity resolution, dedup detection, and scoring.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
